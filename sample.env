# CORIS API credentials
CORIS_API_KEY=your_coris_api_key  # API key for CORIS monitoring system
CATS_USER_ID=your_cats_user_id    # User ID for CORIS monitoring system

# Application configuration
DAYS_BACK=7     # Number of days of historical data to pull during initialization
TESTING=False   # Set to True to run in test mode (limited sensors)

# HOBOlink API credentials
HOBOLINK_CLIENT_ID=your_client_id         # OAuth client ID for HOBOlink API
HOBOLINK_CLIENT_SECRET=your_client_secret # OAuth client secret for HOBOlink API
HOBOLINK_USER_ID=your_user_id             # HOBOlink user ID (numeric)
HOBOLINK_LOGGERS=logger1_id,logger2_id    # Comma-separated list of logger IDs to retrieve data from

# HOBOlink configuration
HOBOLINK_ENABLED=True  # Set to False to disable HOBOlink data collection 